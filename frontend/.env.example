# Frontend env example
# Put these in a file named `.env` at the project root (frontend/) for local development.

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional: override the OAuth redirect (must match Google Cloud Console allowed redirect URIs)
VITE_GOOGLE_OAUTH_REDIRECT=http://localhost:5173/auth/oauth-callback

# Backend API URL (set this in Netlify for production)
VITE_API_BASE_URL=http://localhost:5000/api
# Socket.IO URL (set this in Netlify for production)
VITE_SOCKET_URL=http://localhost:5000
